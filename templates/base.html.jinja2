<!doctype html>
<html>
<head>
    <title>{{ page_title }}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.1/css/bootstrap.min.css"
        integrity="sha384-VCmXjywReHh4PwowAiWNagnWcLhlEJLA5buUprzK8rxFgeH0kww/aWY76TfkUoSX" crossorigin="anonymous">
</head>
<body>
    <div class="jumbotron jumbotron-fluid">
        <div class="container">
            {% block heading %}{% endblock %}
        </div>
    </div>
    <div class="container" id="form_container">
        <form id="theForm">
            <div class="form-group">
                <label for="name">Gender:</label>
                <select class="form-control" name="name" required>
                    <option value="" disabled selected>Select your gender</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
                <small class="form-text text-muted">Required*</small>
            </div>
            <input type="text" name="type" value="{{ type }}" hidden>
            {% block form_questions %}{% endblock %}
            <input type="text" name="formid" value="{{ form_id }}" hidden>
            <input type="text" name="thank" value="Thank you for participating!" hidden>
            <input class="btn btn-info btn-lg" type="submit" value="Submit Results" id="submitBtn">
            <p class="text-muted">
                <small>If you encounter any issues submitting the results, please double-check if you have filled in your gender and answered every question. Thank you.</small>
            </p>
        </form>
    </div>
    <div class="container" style="padding-top: 60px;">
        <p class="text-center text-muted">&copy; CHI, MRI, TUM</p>
    </div>
<script>
        document.getElementById('theForm').addEventListener('submit', function(event) {
            event.preventDefault();
            const questions = document.querySelectorAll('.question');
            let textData = '';
            textData += `Gender: ${document.querySelector('select[name="name"]').value}\n`;
            questions.forEach(question => {
                const questionId = question.getAttribute('data-question-id');
                const selectedOption = question.querySelector('input[type="radio"]:checked');
                if (selectedOption) {
                    textData += `Question ${questionId}: ${selectedOption.value}\n`;
                } else {
                    textData += `Question ${questionId}: No answer\n`;
                }
            });
            const blob = new Blob([textData], { type: 'text/plain' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `mos_results.txt`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        });
    </script>
</body>
</html>
